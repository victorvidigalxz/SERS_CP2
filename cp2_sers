    {
      "cell_type": "code",
      "execution_count": 20,
      "id": "5ed179ae",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5ed179ae",
        "outputId": "19ee2613-1dee-467b-e983-bd8c155d7560"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Usando meteo_regressao_orange.csv já existente (FORCAR_DOWNLOAD=False)\n"
          ]
        }
      ],
      "source": [
        "METEO_API = \"https://archive-api.open-meteo.com/v1/archive\"\n",
        "params = {\n",
        "    \"latitude\": -9.39, \"longitude\": -40.50,\n",
        "    \"start_date\": \"2025-04-01\", \"end_date\": \"2025-06-30\",\n",
        "    \"hourly\": \"temperature_2m,relative_humidity_2m,cloud_cover,wind_speed_10m,shortwave_radiation\",\n",
        "    \"timezone\": \"America/Recife\",\n",
        "}\n",
        "\n",
        "def baixar_meteo():\n",
        "    r = requests.get(METEO_API, params=params, timeout=60)\n",
        "    r.raise_for_status()\n",
        "    h = r.json()[\"hourly\"]\n",
        "    df = pd.DataFrame({\n",
        "        \"data_hora\":     pd.to_datetime(h[\"time\"]),\n",
        "        \"temperatura_c\": h[\"temperature_2m\"],\n",
        "        \"umidade_pct\":   h[\"relative_humidity_2m\"],\n",
        "        \"nuvens_pct\":    h[\"cloud_cover\"],\n",
        "        \"vento_kmh\":     h[\"wind_speed_10m\"],\n",
        "        \"radiacao_w_m2\": h[\"shortwave_radiation\"],\n",
        "    })\n",
        "    df[\"hora\"] = df[\"data_hora\"].dt.hour\n",
        "    df = df[(df[\"hora\"] >= 7) & (df[\"hora\"] <= 17)].reset_index(drop=True)\n",
        "    return df[[\"data_hora\", \"temperatura_c\", \"umidade_pct\", \"nuvens_pct\", \"vento_kmh\", \"hora\", \"radiacao_w_m2\"]]\n",
        "\n",
        "if FORCAR_DOWNLOAD or not os.path.exists(CSV_METEO):\n",
        "    df_meteo = baixar_meteo()\n",
        "    df_meteo.to_csv(CSV_METEO, index=False)\n",
        "    print(\"Gerado\", CSV_METEO, df_meteo.shape)\n",
        "else:\n",
        "    print(\"Usando\", CSV_METEO, \"já existente (FORCAR_DOWNLOAD=False)\")"
      ]
    },
