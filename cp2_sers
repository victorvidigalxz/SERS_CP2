        "---\n",
        "# PARTE A — Geração dos CSVs a partir das APIs públicas (sem token)\n",
        "\n",
        "## A.1 SIGA — ANEEL\n",
        "\n",
        "Consulta à API CKAN do portal de dados abertos (`datastore_search`), com paginação.\n",
        "Se a API falhar, há um *fallback* que baixa o CSV completo do recurso.\n",
        "Agrupamento das classes: `UFV` → **Solar**, `EOL` → **Eólica**, `UHE`/`PCH`/`CGH` → **Hidráulica**."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "id": "9468a9a2",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9468a9a2",
        "outputId": "db3bf03c-319c-46d0-9777-e8e92de58e51"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Usando aneel_classificacao_orange.csv já existente (FORCAR_DOWNLOAD=False)\n"
          ]
        }
      ],
      "source": [
        "ANEEL_RESOURCE_ID = \"11ec447d-698d-4ab8-977f-b424d5deee6a\"\n",
        "ANEEL_API = \"https://dadosabertos.aneel.gov.br/api/3/action/datastore_search\"\n",
        "ANEEL_CSV_URL = (\"https://dadosabertos.aneel.gov.br/dataset/49fa9ca0-f609-4ae3-a6f7-b97bd9428b59/\"\n",
        "                 f\"resource/{ANEEL_RESOURCE_ID}/download/siga-empreendimentos-geracao.csv\")\n",
        "MAPA_FONTE = {\"UFV\": \"Solar\", \"EOL\": \"Eólica\", \"UHE\": \"Hidráulica\", \"PCH\": \"Hidráulica\", \"CGH\": \"Hidráulica\"}\n",
        "CAMPOS = [\"SigTipoGeracao\", \"MdaPotenciaOutorgadaKw\", \"NumCoordNEmpreendimento\", \"NumCoordEEmpreendimento\"]\n",
        "\n",
        "def baixar_aneel_api(limite=1000):\n",
        "    registros, offset = [], 0\n",
        "    while True:\n",
        "        r = requests.get(ANEEL_API, params={\"resource_id\": ANEEL_RESOURCE_ID, \"limit\": limite, \"offset\": offset}, timeout=60)\n",
        "        r.raise_for_status()\n",
        "        res = r.json()[\"result\"]\n",
        "        lote = res[\"records\"]\n",
        "        registros += lote\n",
        "        offset += limite\n",
        "        if not lote or offset >= res.get(\"total\", 0):\n",
        "            break\n",
        "    return pd.DataFrame(registros)\n",
        "\n",
        "def baixar_aneel_csv():\n",
        "    r = requests.get(ANEEL_CSV_URL, timeout=120)\n",
        "    r.raise_for_status()\n",
        "    return pd.read_csv(io.StringIO(r.content.decode(\"utf-8\", errors=\"replace\")), sep=\";\", dtype=str)\n",
        "\n",
        "def para_numero(s):\n",
        "\n",
        "    s = s.astype(str).str.strip()\n",
        "    com_virgula = s.str.contains(\",\", regex=False)\n",
        "    s = s.where(~com_virgula, s.str.replace(\".\", \"\", regex=False).str.replace(\",\", \".\", regex=False))\n",
        "    return pd.to_numeric(s, errors=\"coerce\")\n",
        "\n",
        "def preparar_aneel(bruto):\n",
        "    df = bruto[CAMPOS].copy()\n",
        "    df = df[df[\"SigTipoGeracao\"].isin(MAPA_FONTE)]\n",
        "    out = pd.DataFrame({\n",
        "        \"potencia_kw\": para_numero(df[\"MdaPotenciaOutorgadaKw\"]),\n",
        "        \"latitude\":    para_numero(df[\"NumCoordNEmpreendimento\"]),\n",
        "        \"longitude\":   para_numero(df[\"NumCoordEEmpreendimento\"]),\n",
        "        \"fonte\":       df[\"SigTipoGeracao\"].map(MAPA_FONTE),\n",
        "    })\n",
        "    return out.reset_index(drop=True)\n",
        "\n",
        "if FORCAR_DOWNLOAD or not os.path.exists(CSV_ANEEL):\n",
        "    try:\n",
        "        bruto = baixar_aneel_api()\n",
        "        print(\"Baixado via API datastore:\", bruto.shape)\n",
        "    except Exception as e:\n",
        "        print(\"API falhou (\", e, \") -> usando download do CSV completo\")\n",
        "        bruto = baixar_aneel_csv()\n",
        "    df_aneel = preparar_aneel(bruto)\n",
        "    df_aneel.to_csv(CSV_ANEEL, index=False)\n",
        "    print(\"Gerado\", CSV_ANEEL, df_aneel.shape)\n",
        "else:\n",
        "    print(\"Usando\", CSV_ANEEL, \"já existente (FORCAR_DOWNLOAD=False)\")"
      ]
    },
